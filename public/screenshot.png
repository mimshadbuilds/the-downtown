<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800">
  <!-- Background -->
  <rect width="1200" height="800" fill="#f5f5f5"/>
  
  <!-- Header -->
  <rect width="1200" height="80" fill="#ffffff" stroke="#e0e0e0" stroke-width="1"/>
  <text x="40" y="50" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#333">
    The Downtown
  </text>
  <line x1="40" y1="65" x2="200" y2="65" stroke="#2563eb" stroke-width="3"/>
  
  <!-- Navigation -->
  <rect y="80" width="1200" height="50" fill="#fafafa" stroke="#e0e0e0" stroke-width="1"/>
  <text x="40" y="110" font-family="Arial, sans-serif" font-size="14" fill="#666">TECHNOLOGY</text>
  <text x="200" y="110" font-family="Arial, sans-serif" font-size="14" fill="#666">BUSINESS</text>
  <text x="330" y="110" font-family="Arial, sans-serif" font-size="14" fill="#666">OPINION</text>
  <text x="460" y="110" font-family="Arial, sans-serif" font-size="14" fill="#666">LIFESTYLE</text>
  
  <!-- Featured Section Header -->
  <text x="40" y="160" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#999" letter-spacing="2">FEATURED</text>
  
  <!-- Main Featured Article Card -->
  <rect x="40" y="180" width="600" height="400" fill="#ffffff" stroke="#ddd" stroke-width="1"/>
  <rect x="40" y="180" width="600" height="250" fill="#e0e0e0"/>
  <text x="60" y="400" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#333">
    Breaking News: Innovation Reshapes Industry
  </text>
  <text x="60" y="430" font-family="Arial, sans-serif" font-size="14" fill="#666">
    Discover the latest developments in technology and how they're
  </text>
  <text x="60" y="450" font-family="Arial, sans-serif" font-size="14" fill="#666">
    transforming the business landscape.
  </text>
  <text x="60" y="475" font-family="Arial, sans-serif" font-size="12" fill="#999">By Jane Smith · Sept 6, 2024</text>
  <rect x="60" y="490" width="100" height="35" fill="none" stroke="#2563eb" stroke-width="2"/>
  <text x="75" y="512" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#2563eb">READ MORE</text>
  
  <!-- Right Sidebar -->
  <text x="680" y="160" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#999" letter-spacing="2">TRENDING</text>
  
  <!-- Sidebar Article 1 -->
  <rect x="680" y="180" width="480" height="100" fill="#ffffff" stroke="#ddd" stroke-width="1"/>
  <rect x="680" y="180" width="150" height="100" fill="#e0e0e0"/>
  <text x="850" y="200" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#2563eb">TECHNOLOGY</text>
  <text x="850" y="225" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#333">
    AI Breakthrough Changes Everything
  </text>
  <text x="850" y="260" font-family="Arial, sans-serif" font-size="12" fill="#999">By Tech Team · Sept 5, 2024</text>
  
  <!-- Sidebar Article 2 -->
  <rect x="680" y="300" width="480" height="100" fill="#ffffff" stroke="#ddd" stroke-width="1"/>
  <rect x="680" y="300" width="150" height="100" fill="#e0e0e0"/>
  <text x="850" y="320" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#2563eb">BUSINESS</text>
  <text x="850" y="345" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#333">
    Market Hits Record High
  </text>
  <text x="850" y="380" font-family="Arial, sans-serif" font-size="12" fill="#999">By Finance · Sept 5, 2024</text>
  
  <!-- Sidebar Article 3 -->
  <rect x="680" y="420" width="480" height="100" fill="#ffffff" stroke="#ddd" stroke-width="1"/>
  <rect x="680" y="420" width="150" height="100" fill="#e0e0e0"/>
  <text x="850" y="440" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#2563eb">OPINION</text>
  <text x="850" y="465" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#333">
    The Future of Remote Work
  </text>
  <text x="850" y="500" font-family="Arial, sans-serif" font-size="12" fill="#999">By Opinion Team · Sept 4, 2024</text>
  
  <!-- Bottom Section -->
  <text x="40" y="640" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#999" letter-spacing="2">MORE NEWS</text>
  
  <!-- Bottom Articles Grid -->
  <rect x="40" y="660" width="280" height="120" fill="#ffffff" stroke="#ddd" stroke-width="1"/>
  <rect x="40" y="660" width="280" height="60" fill="#e0e0e0"/>
  <text x="50" y="740" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#333">Article Title Here</text>
  <text x="50" y="765" font-family="Arial, sans-serif" font-size="11" fill="#999">Sept 3, 2024</text>
  
  <rect x="340" y="660" width="280" height="120" fill="#ffffff" stroke="#ddd" stroke-width="1"/>
  <rect x="340" y="660" width="280" height="60" fill="#e0e0e0"/>
  <text x="350" y="740" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#333">Another Article Title</text>
  <text x="350" y="765" font-family="Arial, sans-serif" font-size="11" fill="#999">Sept 2, 2024</text>
  
  <rect x="640" y="660" width="280" height="120" fill="#ffffff" stroke="#ddd" stroke-width="1"/>
  <rect x="640" y="660" width="280" height="60" fill="#e0e0e0"/>
  <text x="650" y="740" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#333">More News Story</text>
  <text x="650" y="765" font-family="Arial, sans-serif" font-size="11" fill="#999">Sept 1, 2024</text>
  
  <rect x="940" y="660" width="280" height="120" fill="#ffffff" stroke="#ddd" stroke-width="1"/>
  <rect x="940" y="660" width="280" height="60" fill="#e0e0e0"/>
  <text x="950" y="740" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#333">Latest Breaking News</text>
  <text x="950" y="765" font-family="Arial, sans-serif" font-size="11" fill="#999">Aug 31, 2024</text>
  
  <!-- Footer -->
  <rect y="790" width="1200" height="10" fill="#333"/>
</svg>
